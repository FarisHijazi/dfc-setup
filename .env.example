# Macvlan IPs (used by control-service and discovery-service on local_net)
CONTROL_SERVICE_MACVLAN_IP=192.168.8.102
DISCOVERY_SERVICE_MACVLAN_IP=192.168.8.103
PASSIVE_MONITOR_MACVLAN_IP=192.168.8.104
