+    def _calculate_min_breaker_changes_distribution(
+        self, total_power: int, supervisor_max_powers: dict[str, int]
+    ) -> dict[str, int]:
+        """
+        Distribute power across supervisors while minimizing the number of breakers whose
+        allocations change from their current setpoints.
+
+        Strategy:
+        - Start from current allocations and apply the delta to the fewest supervisors.
+        - For increases: fill supervisors with most headroom first.
+        - For decreases: try single-supervisor reduction first, then zero out smallest and reduce next.
+        """
+        if not supervisor_max_powers:
+            return {}
+
+        current = dict(self.supervisor_allocations)
+        # Ensure all supervisors are represented
+        for sid in supervisor_max_powers:
+            current.setdefault(sid, 0)
+
+        current_total = sum(current[sid] for sid in supervisor_max_powers)
+        delta = total_power - current_total
+
+        if delta == 0:
+            return {sid: current[sid] for sid in supervisor_max_powers}
+
+        targets = {sid: current[sid] for sid in supervisor_max_powers}
+
+        if delta > 0:
+            remaining = delta
+            # Sort by headroom descending — fill biggest-headroom supervisors first
+            by_headroom = sorted(
+                supervisor_max_powers.keys(),
+                key=lambda sid: supervisor_max_powers[sid] - targets[sid],
+                reverse=True,
+            )
+            for sid in by_headroom:
+                if remaining <= 0:
+                    break
+                headroom = supervisor_max_powers[sid] - targets[sid]
+                if headroom <= 0:
+                    continue
+                add = min(headroom, remaining)
+                targets[sid] += add
+                remaining -= add
+        else:
+            remaining = -delta  # positive amount to shed
+
+            # First pass: check if a single supervisor can absorb the entire decrease
+            supervisor_min_powers = self.supervisor_min_powers
+            active = [
+                sid for sid in supervisor_max_powers if targets[sid] > 0
+            ]
+            for sid in sorted(active, key=lambda s: targets[s] - supervisor_min_powers.get(s, 0), reverse=True):
+                reducible = targets[sid] - supervisor_min_powers.get(sid, 0)
+                if reducible >= remaining:
+                    targets[sid] -= remaining
+                    remaining = 0
+                    break
+
+            if remaining > 0:
+                # Second pass: zero out smallest supervisors first, then reduce the next
+                active = [sid for sid in supervisor_max_powers if targets[sid] > 0]
+                active.sort(key=lambda sid: targets[sid])
+
+                for sid in active:
+                    if remaining <= 0:
+                        break
+                    min_power = supervisor_min_powers.get(sid, 0)
+                    reducible = targets[sid] - min_power
+                    sleepable = targets[sid]
+
+                    if remaining >= sleepable:
+                        targets[sid] = 0
+                        remaining -= sleepable
+                    elif remaining <= reducible:
+                        targets[sid] -= remaining
+                        remaining = 0
+                    else:
+                        targets[sid] = 0
+                        remaining -= sleepable
+
+        return targets
+
