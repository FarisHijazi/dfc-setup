+    def calculate_min_change_targets(self, total_power: int) -> dict[str, int]:
+        """
+        Calculate target power for each miner while minimizing the number of setpoint changes.
+
+        Instead of recalculating all targets from scratch (like calculate_miner_power_targets),
+        this method looks at current miner setpoints and applies the power delta to the
+        fewest miners possible.
+
+        Args:
+            total_power: Total power to distribute (must be within valid range)
+
+        Returns:
+            Dictionary of miner targets that maintain phase balance
+        """
+        if total_power == 0:
+            return dict.fromkeys(self.miner_actors.keys(), 0)
+
+        # Equal allocation across phases (same as proportional)
+        base_power = total_power // 3
+        remaining = total_power % 3
+        phase_allocations = {
+            'A': base_power + (1 if remaining > 0 else 0),
+            'B': base_power + (1 if remaining > 1 else 0),
+            'C': base_power,
+        }
+
+        miner_targets = {}
+        for phase, miners in self.get_phase_miners().items():
+            target_phase_power = phase_allocations[phase]
+
+            if not miners:
+                continue
+
+            # Get current setpoints
+            current = {ip: actor.miner_status.power_setpoint for ip, actor in miners}
+            current_total = sum(current.values())
+            delta = target_phase_power - current_total
+
+            if delta == 0:
+                # No change needed for this phase
+                for ip, _ in miners:
+                    miner_targets[ip] = current[ip]
+            elif delta > 0:
+                miner_targets.update(
+                    self._min_change_increase(miners, current, delta)
+                )
+            else:
+                miner_targets.update(
+                    self._min_change_decrease(miners, current, -delta)
+                )
+
+        return miner_targets
+
+    def _min_change_increase(
+        self,
+        miners: list[tuple[str, 'MinerActor']],
+        current: dict[str, int],
+        delta: int,
+    ) -> dict[str, int]:
+        """
+        Increase phase power by delta, changing the fewest miners possible.
+
+        Strategy: pick miners with most headroom first, max them out one by one.
+        Sleeping miners (power=0) are woken last since wake-up is the most expensive change.
+        """
+        targets = dict(current)  # Start with current setpoints
+        remaining = delta
+
+        # Split into active miners (have headroom) and sleeping miners
+        active_with_headroom = []
+        sleeping = []
+        for ip, actor in miners:
+            if current[ip] > 0:
+                headroom = actor.max_power - current[ip]
+                if headroom > 0:
+                    active_with_headroom.append((ip, actor, headroom))
+            else:
+                sleeping.append((ip, actor))
+
+        # First: increase active miners (sorted by headroom descending — fewer miners touched)
+        active_with_headroom.sort(key=lambda x: x[2], reverse=True)
+        for ip, actor, headroom in active_with_headroom:
+            if remaining <= 0:
+                break
+            add = min(headroom, remaining)
+            targets[ip] = current[ip] + add
+            remaining -= add
+
+        # Second: wake sleeping miners if still needed (sorted by max_power descending)
+        sleeping.sort(key=lambda x: x[1].max_power, reverse=True)
+        for ip, actor in sleeping:
+            if remaining <= 0:
+                break
+            # Must provide at least min_power when waking
+            power = min(actor.max_power, actor.min_power + remaining)
+            # But we need at least min_power worth of delta to wake this miner
+            if remaining >= actor.min_power:
+                power = min(actor.max_power, remaining)
+                targets[ip] = max(actor.min_power, power)
+                remaining -= targets[ip]
+            # else: not enough delta to wake this miner, skip
+
+        return targets
+
+    def _min_change_decrease(
+        self,
+        miners: list[tuple[str, 'MinerActor']],
+        current: dict[str, int],
+        delta: int,
+    ) -> dict[str, int]:
+        """
+        Decrease phase power by delta, changing the fewest miners possible.
+
+        Strategy:
+        1. First try to absorb the delta by reducing a single miner (most to least power).
+        2. If no single miner can absorb it, sleep the smallest miners and reduce the next.
+        """
+        targets = dict(current)
+        remaining = delta
+
+        # Only consider active miners (those with power > 0)
+        active = [(ip, actor) for ip, actor in miners if current[ip] > 0]
+
+        # First pass: check if a single miner can absorb the entire delta (fewest changes = 1)
+        # Sort by reducible headroom descending to find the best single candidate
+        for ip, actor in sorted(active, key=lambda x: current[x[0]] - x[1].min_power, reverse=True):
+            reducible = current[ip] - actor.min_power
+            if reducible >= remaining:
+                targets[ip] = current[ip] - remaining
+                return targets
+
+        # Second pass: need multiple changes. Sleep smallest miners first, then reduce the next.
+        active.sort(key=lambda x: current[x[0]])
+
+        for ip, actor in active:
+            if remaining <= 0:
+                break
+
+            reducible = current[ip] - actor.min_power
+            sleepable = current[ip]
+
+            if remaining >= sleepable:
+                targets[ip] = 0
+                remaining -= sleepable
+            elif remaining <= reducible:
+                targets[ip] = current[ip] - remaining
+                remaining = 0
+            else:
+                # Can't fully absorb delta, reduce to min_power and continue
+                targets[ip] = actor.min_power
+                remaining -= reducible
+                targets[ip] = 0
+                remaining -= sleepable
+
+        return targets
+
