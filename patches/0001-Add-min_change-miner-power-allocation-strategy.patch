+class TestMinChangePhaseBalance:
+    """Verify phase balance is maintained."""
+
+    def test_maintains_equal_phase_distribution(self):
+        """Total power should be split equally across phases."""
+        miners = {
+            '10.0.0.1': make_mock_miner('10.0.0.1', 'A', 3000),
+            '10.0.0.2': make_mock_miner('10.0.0.2', 'B', 3000),
+            '10.0.0.3': make_mock_miner('10.0.0.3', 'C', 3000),
+        }
+        status = build_status(miners)
+        targets = status.calculate_min_change_targets(12000)
+
+        phase_totals = {'A': 0, 'B': 0, 'C': 0}
+        for (ip, actor), power in zip(status.get_phase_miners().items(), [], strict=False):
+            pass
+        # Simpler: just check that all miners get 4000
+        assert targets['10.0.0.1'] == 4000
+        assert targets['10.0.0.2'] == 4000
+        assert targets['10.0.0.3'] == 4000
