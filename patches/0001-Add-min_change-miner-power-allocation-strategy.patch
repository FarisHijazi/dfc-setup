+"""Tests for the min_change miner power allocation strategy.
+
+The min_change strategy minimizes the number of miners whose setpoints change
+when adjusting total power, as opposed to the proportional strategy which
+recalculates all targets from scratch every time.
+"""
+
+import asyncio
+
+import pytest
+import ray
+
+from src.actors.supervisor import SupervisorActor, SupervisorStatus
+from src.core.config.models import MinerConfig, SupervisorConfig
+from tests.mocks import MockMinerActor
+
+
+# ============================================================
+# Helpers
+# ============================================================
+
+def make_mock_miner(ip: str, phase: str, power: int, min_power: int = 1000, max_power: int = 5000):
+    """Create a MockMinerActor with the given current power setpoint."""
+    cfg = MinerConfig(device_id=ip, ip=ip, phase=phase, min_power=min_power, max_power=max_power)
+    mock = MockMinerActor(cfg, supervisor=None, telemetry_ref=None)
+    mock.miner_status.power_setpoint_variable = power
+    mock.miner_status.actual_wattage = power
+    mock.miner_status.is_sleeping = power == 0
+    return mock
+
+
+def build_status(miners: dict[str, MockMinerActor]) -> SupervisorStatus:
+    """Build a SupervisorStatus from a dict of mock miners."""
+    return SupervisorStatus(miners, phase_balance_threshold=0.15, phase_balance_min_power_threshold=100)
+
+
+# ============================================================
+# Unit tests for calculate_min_change_targets (no Ray needed)
+# ============================================================
+
+class TestMinChangeNoOp:
+    """When total power is unchanged, no miners should change."""
+
+    def test_same_total_power_no_changes(self):
+        """If requested total equals current total, all miners keep their setpoints."""
+        miners = {
+            '10.0.0.1': make_mock_miner('10.0.0.1', 'A', 3000),
+            '10.0.0.2': make_mock_miner('10.0.0.2', 'B', 3000),
+            '10.0.0.3': make_mock_miner('10.0.0.3', 'C', 3000),
+        }
+        status = build_status(miners)
+        targets = status.calculate_min_change_targets(9000)
+
+        assert targets == {'10.0.0.1': 3000, '10.0.0.2': 3000, '10.0.0.3': 3000}
+
+    def test_zero_to_zero(self):
+        """All sleeping miners stay at 0 when target is 0."""
+        miners = {
+            '10.0.0.1': make_mock_miner('10.0.0.1', 'A', 0),
+            '10.0.0.2': make_mock_miner('10.0.0.2', 'B', 0),
+            '10.0.0.3': make_mock_miner('10.0.0.3', 'C', 0),
+        }
+        status = build_status(miners)
+        targets = status.calculate_min_change_targets(0)
+
+        assert all(v == 0 for v in targets.values())
+
+
+class TestMinChangeIncrease:
+    """Tests for increasing total power with minimum miner changes."""
+
+    def test_small_increase_changes_one_miner(self):
+        """A small power increase should only change one miner per phase that needs it."""
+        miners = {
+            '10.0.0.1': make_mock_miner('10.0.0.1', 'A', 3000),
+            '10.0.0.2': make_mock_miner('10.0.0.2', 'B', 3000),
+            '10.0.0.3': make_mock_miner('10.0.0.3', 'C', 3000),
+        }
+        status = build_status(miners)
+        # Increase by 300W (100W per phase)
+        targets = status.calculate_min_change_targets(9300)
+
+        # Each phase has exactly 1 miner, so each changes by 100W
+        assert targets['10.0.0.1'] == 3100
+        assert targets['10.0.0.2'] == 3100
+        assert targets['10.0.0.3'] == 3100
+        assert sum(targets.values()) == 9300
+
+    def test_increase_uses_fewest_miners(self):
+        """With multiple miners per phase, only the ones with most headroom should change."""
+        miners = {
+            '10.0.0.1': make_mock_miner('10.0.0.1', 'A', 3000, max_power=5000),  # 2000 headroom
+            '10.0.0.4': make_mock_miner('10.0.0.4', 'A', 3000, max_power=5000),  # 2000 headroom
+            '10.0.0.2': make_mock_miner('10.0.0.2', 'B', 3000, max_power=5000),  # 2000 headroom
+            '10.0.0.5': make_mock_miner('10.0.0.5', 'B', 3000, max_power=5000),  # 2000 headroom
+            '10.0.0.3': make_mock_miner('10.0.0.3', 'C', 3000, max_power=5000),
+            '10.0.0.6': make_mock_miner('10.0.0.6', 'C', 3000, max_power=5000),
+        }
+        status = build_status(miners)
+        # Current total: 18000 (6000/phase)
+        # Request: 19500 → 6500/phase, +500/phase
+        # Each phase has 2 miners at 3000 with 2000 headroom each.
+        # Only ONE miner per phase should change (absorbs the 500W delta).
+        targets = status.calculate_min_change_targets(19500)
+        assert sum(targets.values()) == 19500
+
+        # Per phase, only 1 miner should change
+        for phase_ips in [('10.0.0.1', '10.0.0.4'), ('10.0.0.2', '10.0.0.5'), ('10.0.0.3', '10.0.0.6')]:
+            changed = sum(1 for ip in phase_ips if targets[ip] != 3000)
+            assert changed == 1, f'Expected 1 change, got {changed}: {[(ip, targets[ip]) for ip in phase_ips]}'
+
+    def test_increase_from_zero_wakes_miners(self):
+        """Increasing from 0 should wake the minimum number of miners."""
+        miners = {
+            '10.0.0.1': make_mock_miner('10.0.0.1', 'A', 0, min_power=1000, max_power=5000),
+            '10.0.0.2': make_mock_miner('10.0.0.2', 'B', 0, min_power=1000, max_power=5000),
+            '10.0.0.3': make_mock_miner('10.0.0.3', 'C', 0, min_power=1000, max_power=5000),
+        }
+        status = build_status(miners)
+        # Request 3000W (1000 per phase) — exactly min_power for each
+        targets = status.calculate_min_change_targets(3000)
+
+        assert sum(targets.values()) == 3000
+        # Each phase needs 1000W, each miner's min_power is 1000, so each wakes at 1000
+        assert targets['10.0.0.1'] == 1000
+        assert targets['10.0.0.2'] == 1000
+        assert targets['10.0.0.3'] == 1000
+
+    def test_increase_prefers_active_over_sleeping(self):
+        """Active miners with headroom should be increased before waking sleeping miners."""
+        miners = {
+            '10.0.0.1': make_mock_miner('10.0.0.1', 'A', 3000, max_power=5000),
+            '10.0.0.4': make_mock_miner('10.0.0.4', 'A', 0, min_power=1000, max_power=5000),  # sleeping
+            '10.0.0.2': make_mock_miner('10.0.0.2', 'B', 3000, max_power=5000),
+            '10.0.0.3': make_mock_miner('10.0.0.3', 'C', 3000, max_power=5000),
+        }
+        status = build_status(miners)
+        # Current: A=3000, B=3000, C=3000 = 9000
+        # Request 10500 → 3500/phase
+        # Phase A current: 3000, target: 3500 → +500. Active miner has 2000 headroom.
+        # Should increase 10.0.0.1 by 500, NOT wake 10.0.0.4
+        targets = status.calculate_min_change_targets(10500)
+
+        assert targets['10.0.0.1'] == 3500
+        assert targets['10.0.0.4'] == 0  # stays sleeping
+        assert targets['10.0.0.2'] == 3500
+        assert targets['10.0.0.3'] == 3500
+        assert sum(targets.values()) == 10500
+
+    def test_increase_beyond_active_headroom_wakes_sleeper(self):
+        """If active miners can't absorb the increase, sleeping miners should wake."""
+        miners = {
+            '10.0.0.1': make_mock_miner('10.0.0.1', 'A', 4500, max_power=5000),  # 500 headroom
+            '10.0.0.4': make_mock_miner('10.0.0.4', 'A', 0, min_power=1000, max_power=5000),  # sleeping
+            '10.0.0.2': make_mock_miner('10.0.0.2', 'B', 4500, max_power=5000),
+            '10.0.0.5': make_mock_miner('10.0.0.5', 'B', 0, min_power=1000, max_power=5000),  # sleeping
+            '10.0.0.3': make_mock_miner('10.0.0.3', 'C', 4500, max_power=5000),
+            '10.0.0.6': make_mock_miner('10.0.0.6', 'C', 0, min_power=1000, max_power=5000),  # sleeping
+        }
+        status = build_status(miners)
+        # Current: A=4500, B=4500, C=4500 = 13500
+        # Request 18000 → 6000/phase
+        # Phase A: need 6000, active at 4500 has 500 headroom → 5000, need 1000 more → wake sleeper at 1000
+        # Phase B: same
+        # Phase C: same
+        targets = status.calculate_min_change_targets(18000)
+
+        assert targets['10.0.0.1'] == 5000  # maxed out
+        assert targets['10.0.0.4'] >= 1000  # woken, at least min_power
+        phase_a_total = targets['10.0.0.1'] + targets['10.0.0.4']
+        assert phase_a_total == 6000
+        assert sum(targets.values()) == 18000
+
+
+class TestMinChangeDecrease:
+    """Tests for decreasing total power with minimum miner changes."""
+
+    def test_small_decrease_changes_one_miner_per_phase(self):
+        """A small decrease should only reduce one miner per affected phase."""
+        miners = {
+            '10.0.0.1': make_mock_miner('10.0.0.1', 'A', 3000),
+            '10.0.0.2': make_mock_miner('10.0.0.2', 'B', 3000),
+            '10.0.0.3': make_mock_miner('10.0.0.3', 'C', 3000),
+        }
+        status = build_status(miners)
+        # Decrease by 300W (100W per phase)
+        targets = status.calculate_min_change_targets(8700)
+
+        assert targets['10.0.0.1'] == 2900
+        assert targets['10.0.0.2'] == 2900
+        assert targets['10.0.0.3'] == 2900
+        assert sum(targets.values()) == 8700
+
+    def test_large_decrease_sleeps_miners(self):
+        """A large decrease should sleep some miners rather than spread thin."""
+        miners = {
+            '10.0.0.1': make_mock_miner('10.0.0.1', 'A', 2000, min_power=1000, max_power=5000),
+            '10.0.0.4': make_mock_miner('10.0.0.4', 'A', 3000, min_power=1000, max_power=5000),
+            '10.0.0.2': make_mock_miner('10.0.0.2', 'B', 3000, min_power=1000, max_power=5000),
+            '10.0.0.3': make_mock_miner('10.0.0.3', 'C', 3000, min_power=1000, max_power=5000),
+        }
+        status = build_status(miners)
+        # Current: A=5000, B=3000, C=3000 = 11000
+        # Request 6000 → 2000/phase
+        # Phase A: current 5000, target 2000 → need to shed 3000
+        #   Sleep 10.0.0.1 (2000W) → shed 2000, then reduce 10.0.0.4 by 1000 → 2000
+        # Phase B: 3000 → 2000, reduce by 1000
+        # Phase C: 3000 → 2000, reduce by 1000
+        targets = status.calculate_min_change_targets(6000)
+
+        assert sum(targets.values()) == 6000
+        # Phase A total should be 2000
+        assert targets['10.0.0.1'] + targets['10.0.0.4'] == 2000
+
+    def test_decrease_to_zero(self):
+        """Decreasing to 0 should sleep all miners."""
+        miners = {
+            '10.0.0.1': make_mock_miner('10.0.0.1', 'A', 3000),
+            '10.0.0.2': make_mock_miner('10.0.0.2', 'B', 3000),
+            '10.0.0.3': make_mock_miner('10.0.0.3', 'C', 3000),
+        }
+        status = build_status(miners)
+        targets = status.calculate_min_change_targets(0)
+
+        assert all(v == 0 for v in targets.values())
+
+    def test_decrease_respects_min_power(self):
+        """Miners should either stay at/above min_power or go to 0 (sleep)."""
+        miners = {
+            '10.0.0.1': make_mock_miner('10.0.0.1', 'A', 3000, min_power=1000),
+            '10.0.0.2': make_mock_miner('10.0.0.2', 'B', 3000, min_power=1000),
+            '10.0.0.3': make_mock_miner('10.0.0.3', 'C', 3000, min_power=1000),
+        }
+        status = build_status(miners)
+        targets = status.calculate_min_change_targets(6000)
+
+        for ip, power in targets.items():
+            assert power == 0 or power >= 1000, f'{ip} has invalid power {power}'
+        assert sum(targets.values()) == 6000
+
